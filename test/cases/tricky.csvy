---
# Labels that gnuplot's own reader would mangle, and t_end left to the template.
template: templates/gantt
vars:
  t: {start: 0, grid: 2}
gnuplot:
  # LaTeX in a gnuplot string: gnuplot single quotes inside a YAML '>-' block
  xlabel: >-
    'Time (\textit{months}, it''s $t$)'
---
Index,Start,End,Color,Buffer,BufferColor,Label
1,0,2,#29bb78,0.5,#69cfa1,"A, B \& C"
2,0,3,#2972db,1,#699ce6,\textbf{EEM}

3,0,4,#eb6034,1,#f19071,it's
